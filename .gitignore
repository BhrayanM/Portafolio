# ─────────────────────────────────────────────────────────────
#  PORTAFOLIO SAAS — .gitignore BLINDADO
#  Prohibido subir: .env, claves, workflows, datos reales.
# ─────────────────────────────────────────────────────────────

# ── Cuarentena estricta ──────────────────────────────────────
_PRIVADO_NO_SUBIR/
_private/
private/
personal/

# ── Config pública del IDE (NUNCA se sube) ──────────────────
opencode.json

# ── Secretos y credenciales ──────────────────────────────────
.env
.env.*
!.env.example
*.env
env/
secrets/
credentials/
credentials.json
client_secret*.json
service-account*.json
*service_account*
gcp-*.json
token.json
tokens/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.keystore
*.jks
id_rsa*
id_ed25519*
.htpasswd
.netrc
.npmrc
.pgpass
.aws/
.ssh/
*apikey*
*api_key*
*secret*
!SECURITY.md

# ── Exportaciones de n8n (NUNCA se publican) ─────────────────
*.workflow.json
workflow*.json
*workflow*.json
n8n/data/
n8n/.n8n/
n8n-data/
n8n_data/
exports/
executions/
*execution*.json
*.credentials.json
credentials*.json
flows/
workflows/
# Los exports de workflows n8n NO se versionan aqui: este repo es publico y
# SECURITY.md los prohibe (grafo real, Code nodes, prompts, credential IDs).
# Se respaldan fuera del repo. Reforzado por .git/hooks/pre-commit.

# ── Bases de datos, dumps, backups ───────────────────────────
*.sqlite
*.sqlite3
*.db
*.db3
*.mdb
*.sql
!database/migrations/*.sql
!database/seeds/*.sql
*.dump
*.bak
*.bacpac
dumps/
backups/
backup/
pg_dump*
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
!assets/**/*.zip

# ── Datos de clientes / PII ─────────────────────────────────
*.csv
*.tsv
*.xlsx
*.xls
data/
datasets/
leads/
contacts/
transcripts/
recordings/
/uploads
uploads/
attachments/

