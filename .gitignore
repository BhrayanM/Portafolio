# ─────────────────────────────────────────────────────────────
#  PORTAFOLIO SAAS — .gitignore BLINDADO
#  Prohibido subir: .env, claves, workflows, datos reales.
# ─────────────────────────────────────────────────────────────

# ── Cuarentena estricta ──────────────────────────────────────
_PRIVADO_NO_SUBIR/
_private/
private/
personal/

# ── Config pública del IDE (NUNCA se sube) ──────────────────
opencode.json

# ── Internal agent context and working documents (local only) ──
CLAUDE.md
AGENTS.md
MEMORY.md
PROGRESO.md
PROJECT_STATUS.md
DECISIONS.md
CHANGELOG_AI.md

# ── Internal process documentation (not portfolio material) ──
docs/AUDITORIA_*.md
docs/CIERRE_FASE.md
docs/FASE19_*.md
docs/FASE20_*.md
docs/FASE21_*.md
docs/HANDOFF.md
docs/IMPLEMENTATION_PLAN.md
docs/LECCIONES_APRENDIDAS.md
docs/LOG_AUTONOMO.md
docs/PLAN_REMEDIACION.md
docs/PRODUCCION_CHECKLIST.md
docs/RELEASE_CHECKLIST.md
docs/REMEDIACION_COMPLETA.md
docs/REPORTE_FASE_*.md
docs/SPRINT*.md
docs/VALIDACION_RUNTIME.md
docs/fase-*/

# ── Secretos y credenciales ──────────────────────────────────
.env
.env.*
!.env.example
*.env
env/
secrets/
credentials/
credentials.json
client_secret*.json
service-account*.json
*service_account*
gcp-*.json
token.json
tokens/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.keystore
*.jks
id_rsa*
id_ed25519*
.htpasswd
.netrc
.npmrc
.pgpass
.aws/
.ssh/
# Patrones específicos para secretos reales (no código)
*apikey*.secret
*api_key*.key
*secret*.key
*secret*.pem
*secret*.env
!SECURITY.md

# ── Exportaciones de n8n (NUNCA se publican) ─────────────────
*.workflow.json
workflow*.json
*workflow*.json
n8n/data/
n8n/.n8n/
n8n-data/
n8n_data/
exports/
executions/
*execution*.json
*.credentials.json
credentials*.json
flows/
# n8n workflow exports are NOT versioned here — this is a public repo.
# An anchor prevents the pattern from matching `.github/workflows/`.
/n8n/workflows/

