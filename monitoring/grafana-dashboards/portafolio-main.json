{
  "title": "Portafolio SaaS — Dashboard",
  "uid": "portafolio-main",
  "tags": ["portafolio", "production"],
  "timezone": "America/Mexico_City",
  "panels": [
    {
      "title": "CPU Usage",
      "type": "gauge",
      "targets": [{ "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "legendFormat": "CPU" }]
    },
    {
      "title": "Memory Usage",
      "type": "gauge",
      "targets": [{ "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "RAM" }]
    },
    {
      "title": "Disk Usage",
      "type": "gauge",
      "targets": [{ "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})", "legendFormat": "Disk" }]
    },
    {
      "title": "Uptime",
      "type": "stat",
      "targets": [{ "expr": "time() - node_boot_time_seconds", "legendFormat": "Uptime" }]
    }
  ]
}
