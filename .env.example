# ═════════════════════════════════════════════════════════════
#  PORTAFOLIO SAAS — Variables de Entorno
#  Copia este archivo como .env y completa tus valores reales
#  ADVERTENCIA: .env está en .gitignore — NUNCA se commitea
# ═════════════════════════════════════════════════════════════

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme_super_segura
POSTGRES_DB=n8n

# ── n8n ──────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
WEBHOOK_URL=
N8N_ENCRYPTION_KEY=changeme_ejecuta:_openssl_rand_-hex_32
N8N_METRICS=false

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-tu_key_aqui

# ── Groq (activo, OpenAI sin saldo) ───────────────────────────
GROQ_API_KEY=gsk-tu_key_aqui

# ── HubSpot ──────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ── Slack ────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# ── WhatsApp Cloud API ───────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Twilio (Voice) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Stripe ─────────────────────────────────────────
# Generar en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook secret desde https://dashboard.stripe.com/test/webhooks
# Requerido para verificar firma en /api/billing/webhook
# OBLIGATORIA en produccion, el backend no arranca sin ella. Vacia, la
# firma del webhook pasa a ser forjable por cualquiera (HMAC con clave vacia).
#
# REQUISITO PREVIO DE DESPLIEGUE. No se inventa ningun valor de relleno:
# el secreto real lo emite Stripe al dar de alta el endpoint (whsec_...). Sin el:
#   - NODE_ENV=production -> el proceso ABORTA en el arranque (config/index.js).
#   - Fuera de produccion  -> /api/billing/webhook responde 503
#                             STRIPE_WEBHOOK_NOT_CONFIGURED en vez de verificar
#                             la firma contra la cadena vacia.
# En desarrollo/CI se deja vacia a proposito: se prueba el rechazo, no la firma.
STRIPE_WEBHOOK_SECRET=
# Publishable key para Stripe Elements (frontend, opcional si solo checkout server-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── JWT ───────────────────────────────────
JWT_SECRET=changeme_genera_con_openssl_rand_-hex_64
# 24h, sin refresh tokens. En produccion JWT_SECRET es OBLIGATORIA:
# si falta, el backend NO arranca (ya no hay secreto por defecto en el codigo).
JWT_EXPIRES_IN=24h

# ── Backend API ──────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
# Numero de proxies delante del backend. Con nginx delante: 1.
# Vacio/0/false = desactivado, el valor por defecto: sin proxy delante, confiar en
# X-Forwarded-For dejaria a cualquier cliente falsear su IP y saltarse el rate limit.
# Acepta tambien 'loopback' o una subred (ver backend/src/config/index.js).
TRUST_PROXY=
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ── Frontend ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Timeout del cliente HTTP del frontend (AbortController en src/lib/api.ts).
# La lee el navegador, por eso NECESITA el prefijo NEXT_PUBLIC_ y se
# hornea en el build, no en runtime. Vacia = 10000 ms.
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=10000

# (Redis se declara mas abajo, en el bloque "Redis". Antes
#  estaba declarado DOS veces con valores distintos y ganaba el segundo.)

# ── Monitoreo ─────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ── Entorno / logging ────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Conexión a PostgreSQL desde el backend ───────────────────
# Fuera de Docker suele ser localhost; dentro de la red de compose, "postgres".
DB_HOST=localhost
DB_PORT=5432

# ── Rol de aplicacion — REQUERIDO para el aislamiento por tenant ──
# POSTGRES_USER es SUPERUSUARIO en la imagen oficial de PostgreSQL, y un
# superusuario ignora Row Level Security aunque las tablas tengan FORCE RLS.
# Mientras el backend conecte con el, las politicas de la migracion 016 no
# filtran nada: el aislamiento entre tenants queda solo en manos del
# `WHERE tenant_id` del codigo.
#
# La migracion 012 crea el rol `app` (NOSUPERUSER, NOBYPASSRLS) como NOLOGIN,
# porque este repositorio es publico y no puede llevar credenciales.
# Habilitarlo una vez en el despliegue:
#
#     ALTER ROLE app LOGIN PASSWORD '<generada, fuera de git>';
#
# y descomentar estas dos lineas (flujo de desarrollo EN HOST):
# DB_USER=app
# DB_PASSWORD=
#
# ── Rol de aplicacion para el STACK DOCKER ──────────────────
# El stack usa ESTAS dos, no las de arriba. Motivo: `.env` lo comparten el stack
# y el backend ejecutado en host, y cada uno apunta a un PostgreSQL distinto.
# docker-compose.prod.yml las mapea a DB_USER/DB_PASSWORD dentro del contenedor.
#
# OBLIGATORIAS: el compose usa `${DB_APP_USER:?}` / `${DB_APP_PASSWORD:?}`, asi
# que si faltan el stack NO arranca. Es deliberado: un fallback silencioso al
# superusuario desactivaria RLS sin que nadie se entere.
#
# Generar la password fuera de git y habilitar el rol una sola vez:
#     ALTER ROLE app LOGIN PASSWORD '<generada>';
DB_APP_USER=app
DB_APP_PASSWORD=

# ── Topologia del frontend en el stack Docker ───────────────
# NEXT_PUBLIC_API_URL se hornea EN TIEMPO DE BUILD (ver frontend/Dockerfile), asi
# que NO basta con ponerla arriba: el compose la inyecta como build arg desde
# esta variable. Debe apuntar al vhost de la API que declara docker/nginx.conf.
# Cambiar `example.com` por el dominio real al desplegar.
FRONTEND_API_URL=https://api.example.com/api

# Origenes que el backend acepta por CORS cuando corre en el stack Docker. El
# navegador carga el frontend desde https://example.com y llama a
# https://api.example.com: son origenes distintos y `credentials: 'include'`
# exige Allow-Origin exacto (nunca '*'). CORS_ORIGINS de mas abajo queda para el
# flujo en host.
PROD_CORS_ORIGINS=https://example.com,https://www.example.com

# ── Sesión: cookie HttpOnly (el JWT ya no va en localStorage) ─
AUTH_COOKIE_NAME=access_token
# lax cubre el caso normal. Usa "none" (+ HTTPS) si el frontend está en otro dominio.
AUTH_COOKIE_SAMESITE=lax
# Vacío = el navegador usa el host actual. Rellenar solo para compartir subdominios.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_MAX_AGE_MS=604800000

# Orígenes autorizados para CORS con credenciales (separados por coma).
# Con cookies no se admite "*".
# OBLIGATORIA en produccion. El backend no arranca si falta, si vale
# '*' o si incluye localhost. En desarrollo se usa el valor de abajo por defecto.
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Intentos de login permitidos por ventana de 15 min (se desactiva con NODE_ENV=test).
AUTH_RATE_LIMIT_MAX=5
# Altas de usuario permitidas por ventana de 15 min (ruta admin-only).
REGISTER_RATE_LIMIT_MAX=5

# ── Redis (opcional, declaracion UNICA) ─────────────
# Este bloque estaba duplicado (arriba habia otro con REDIS_HOST=redis y
# password vacia). dotenv se queda con la ULTIMA aparicion, asi que el de arriba no
# tenia efecto: dentro de Docker habria intentado conectar a localhost.
# REDIS_HOST: 'localhost' fuera de Docker · 'redis' dentro de la red de compose.
# Hoy no hay ningun consumidor de Redis: sigue sin cablear.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass

# ── RabbitMQ (opcional) ─────────────────────────────
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://admin:rabbitpass@localhost:5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=rabbitpass
