# ═════════════════════════════════════════════════════════════
#  AI AUTOMATION PLATFORM — Environment Variables
#  Copy this file as .env and fill in your real values
#  WARNING: .env is in .gitignore — NEVER commit it
# ═════════════════════════════════════════════════════════════

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme_super_segura
POSTGRES_DB=n8n

# ── n8n ──────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
WEBHOOK_URL=
N8N_ENCRYPTION_KEY=changeme_run:_openssl_rand_-hex_32
N8N_METRICS=false

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your_key_here

# ── Groq (active; OpenAI has no balance) ─────────────────────
GROQ_API_KEY=gsk-your_key_here

# ── HubSpot ──────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ── Slack ────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# ── WhatsApp Cloud API ───────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Twilio (Voice) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Stripe ─────────────────────────────────────────
# Generate at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook secret from https://dashboard.stripe.com/test/webhooks
# Required to verify signatures on /api/billing/webhook
# MANDATORY in production: the backend will not start without it. Empty, the
# webhook signature becomes forgeable by anyone (HMAC with an empty key).
#
# DEPLOYMENT PREREQUISITE. No placeholder value is invented:
# Stripe issues the real secret when the endpoint is registered (whsec_...). Without it:
#   - NODE_ENV=production -> the process ABORTS at startup (config/index.js).
#   - Outside production  -> /api/billing/webhook responds 503
#                             STRIPE_WEBHOOK_NOT_CONFIGURED instead of verifying
#                             the signature against the empty string.
# In development/CI it is left empty on purpose: rejection is tested, not the signature.
STRIPE_WEBHOOK_SECRET=
# Publishable key for Stripe Elements (frontend; optional for server-side checkout only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── JWT ───────────────────────────────────
JWT_SECRET=changeme_generate_with_openssl_rand_-hex_64
# 24h, no refresh tokens. In production JWT_SECRET is MANDATORY:
# if missing, the backend will NOT start (no default secret in code anymore).
JWT_EXPIRES_IN=24h

# ── Backend API ──────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
# Number of proxies in front of the backend. With nginx in front: 1.
# Empty/0/false = disabled, the default: no proxy in front, trusting
# X-Forwarded-For would let any client spoof their IP and bypass the rate limit.
# Also accepts 'loopback' or a subnet (see backend/src/config/index.js).
TRUST_PROXY=
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ── Frontend ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Frontend HTTP client timeout (AbortController in src/lib/api.ts).
# Read by the browser, so it NEEDS the NEXT_PUBLIC_ prefix and is
# baked into the build, not read at runtime. Empty = 10000 ms.
NEXT_PUBLIC_REQUEST_TIMEOUT_MS=10000

# (Redis is declared below, in the "Redis" block. It was previously
#  declared TWICE with different values and the second one won.)

# ── Monitoring ─────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ── Environment / logging ────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL connection from the backend ───────────────────
# Outside Docker this is usually localhost; inside the compose network, "postgres".
DB_HOST=localhost
DB_PORT=5432

# ── Application role — REQUIRED for tenant isolation ──
# POSTGRES_USER is a SUPERUSER in the official PostgreSQL image, and a
# superuser ignores Row Level Security even with FORCE RLS on the tables.
# While the backend connects with it, the migration 016 policies
# filter nothing: tenant isolation relies only on the
# `WHERE tenant_id` in code.
#
# Migration 012 creates the `app` role (NOSUPERUSER, NOBYPASSRLS) as NOLOGIN,
# because this repository is public and cannot carry credentials.
# Enable it once per deployment:
#
#     ALTER ROLE app LOGIN PASSWORD '<generated, outside git>';
#
# and uncomment these two lines (HOST development flow):
# DB_USER=app
# DB_PASSWORD=

# ── Application role for the DOCKER STACK ──────────────────
# The stack uses THESE two, not the ones above. Why: `.env` is shared by the stack
# and the host-run backend, and each points to a different PostgreSQL.
# docker-compose.prod.yml maps them to DB_USER/DB_PASSWORD inside the container.
#
# MANDATORY: compose uses `${DB_APP_USER:?}` / `${DB_APP_PASSWORD:?}`, so
# if they are missing the stack will NOT start. That is deliberate: a silent
# fallback to the superuser would disable RLS without anyone noticing.
#
# Generate the password outside git and enable the role once:
#     ALTER ROLE app LOGIN PASSWORD '<generated>';
DB_APP_USER=app
DB_APP_PASSWORD=

# ── Frontend topology in the Docker stack ───────────────
# NEXT_PUBLIC_API_URL is baked AT BUILD TIME (see frontend/Dockerfile), so
# setting it above is not enough: compose injects it as a build arg from
# this variable. It must point to the API vhost declared in docker/nginx.conf.
# Replace `example.com` with the real domain when deploying.
FRONTEND_API_URL=https://api.example.com/api

# Origins the backend accepts via CORS when running in the Docker stack. The
# browser loads the frontend from https://example.com and calls
# https://api.example.com: these are different origins and `credentials: 'include'`
# requires an exact Allow-Origin (never '*'). CORS_ORIGINS below stays for the
# host flow.
PROD_CORS_ORIGINS=https://example.com,https://www.example.com

# ── Session: HttpOnly cookie (JWT no longer in localStorage) ─
AUTH_COOKIE_NAME=access_token
# lax covers the normal case. Use "none" (+ HTTPS) if the frontend is on another domain.
AUTH_COOKIE_SAMESITE=lax
# Empty = the browser uses the current host. Fill only to share subdomains.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_MAX_AGE_MS=604800000

# Authorized origins for CORS with credentials (comma-separated).
# With cookies, "*" is not allowed.
# MANDATORY in production. The backend will not start if missing, if it is
# '*' or if it includes localhost. In development the default below is used.
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Allowed login attempts per 15-minute window (disabled with NODE_ENV=test).
AUTH_RATE_LIMIT_MAX=5
# Allowed user registrations per 15-minute window (admin-only route).
REGISTER_RATE_LIMIT_MAX=5

# ── Redis (optional, single declaration) ─────────────
# This block was previously duplicated (another with REDIS_HOST=redis and an
# empty password). dotenv keeps the LAST occurrence, so the other one had no
# effect: inside Docker it would have tried to connect to localhost.
# REDIS_HOST: 'localhost' outside Docker · 'redis' inside the compose network.
# No Redis consumer exists today: still not wired up.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass

# ── RabbitMQ (optional) ─────────────────────────────
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://admin:rabbitpass@localhost:5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=rabbitpass
