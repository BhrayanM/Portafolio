# ═════════════════════════════════════════════════════════════
#  PORTAFOLIO SAAS — Variables de Entorno
#  Copia este archivo como .env y completa tus valores reales
#  ADVERTENCIA: .env está en .gitignore — NUNCA se commitea
# ═════════════════════════════════════════════════════════════

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme_super_segura
POSTGRES_DB=n8n

# ── n8n ──────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
WEBHOOK_URL=
N8N_ENCRYPTION_KEY=changeme_ejecuta:_openssl_rand_-hex_32
N8N_METRICS=false

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-tu_key_aqui

# ── HubSpot ──────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ── Slack ────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# ── WhatsApp Cloud API ───────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Twilio (Voice) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── JWT (Backend) ────────────────────────────────────────────────
JWT_SECRET=changeme_genera_con_openssl_rand_-hex_64
JWT_EXPIRES_IN=7d

# ── Backend API ──────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Redis ────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Monitoring ────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
